from setuptools import setup, find_packages
from setuptools.dist import Distribution

class BinaryDistribution(Distribution):
    """Distribution which always forces a binary package with platform name"""
    def has_ext_modules(foo):
        return True

setup(
    name='cerium',
    version='${PROJECT_VERSION}',
    author='Siddharth Jayashankar',
    author_email='sidjay@cmu.edu',
    description='Compiler for the Cerium Framework for Encrypted AI',
    packages=find_packages(),
    package_data={
        'cerium.compiler': ['$<TARGET_FILE_NAME:cerium_compiler_py_${Python3_VERSION_MINOR}>'],
        'cerium.runtime': ['$<TARGET_FILE_NAME:cerium_runtime_py_${Python3_VERSION_MINOR}>'],
    },
    distclass=BinaryDistribution,
    install_requires=[
        'psutil',
    ],
)
